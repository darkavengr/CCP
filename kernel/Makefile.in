ASM=nasm
CC=@arch@-elf-gcc
LD=@arch@-elf-gcc
FILES=@buildroot@/kernel/drive.c @buildroot@/kernel/memorymanager.c @buildroot@/kernel/ccp.c @buildroot@/kernel/device.c @buildroot@/kernel/vfs.c @buildroot@/kernel/initrd.c @buildroot@/kernel/process.c @buildroot@/kernel/multitasking.c @buildroot@/kernel/module.c @buildroot@/kernel/kprintf_direct.c @buildroot@/kernel/error.c @buildroot@/kernel/string.c @buildroot@/kernel/timedate.c @buildroot@/kernel/memorymap.c @buildroot@/kernel/getfullpath.c @buildroot@/kernel/tty.c @buildroot@/kernel/timer.c
CCOPTS=@cc_opts@ -I@buildroot@/header -I@buildroot@/kernel/hwdep/@arch@
LDOPTS=@ldopts@ -Wl,-Map -Wl,@buildroot@/mapfiles/ccp.map
OBJFILES=$(addsuffix .o,$(basename $(notdir $(FILES))))

#
# NOTE: Generation of the drive.c file requires a map file created by the linker.
# The kernel is linked twice; first with a dummy drive.c file to create a map file, then
# the real drive.c is created and the kernel is linked a second time with the real drive.c.
#
all: modules ccp hwdep
	# link first time with dummy drive.c
	$(CC) -T hwdep/@arch@/ld.script -o @buildroot@/bin/@arch@/CCP.SYS @buildroot@/obj/@arch@/*.o $(LDOPTS)
	@buildroot@/gendrivelist @arch@ @driver_list@		# generate real drive.c

	# Recompile drive.c
	$(CC) -c -w -ffreestanding -nostdlib -mcmodel=large -mno-red-zone -I@buildroot@/header -I@buildroot@/kernel/hwdep/x86_64  @buildroot@/kernel/drive.c -o @buildroot@/obj/@arch@/drive.o

	# link second time with real drive.c
	$(CC) -T hwdep/@arch@/ld.script -o @buildroot@/bin/@arch@/CCP.SYS @buildroot@/obj/@arch@/*.o $(LDOPTS)


	@buildroot@/gensym @buildroot@/bin/@arch@/CCP.SYS @buildroot@/mapfiles/ccp.sym

#
# Recipe to make kernel
#
ccp: $(OBJFILES)
	echo $(OBJFILES)

#
# Recipe to make hardware-dependent code
#

.PHONY: hwdep
hwdep:
	make -C hwdep/@arch@

#
# Recipe to make modules
#
.PHONY: modules
modules:
	for f in @driver_list@; do make -C $$f;done
	for f in @initrd_driver_list@; do make -C $$f;done
	@buildroot@/gendrivelist		# generate empty drive.c to allow for first linking

#
# Recipe to make modules
#
$(OBJFILES): %.o: %.c
	$(CC) @cc_opts@ -I@buildroot@/header -I@buildroot@/kernel/hwdep/@arch@ $< -o $(addprefix @buildroot@/obj/@arch@/,$@)

